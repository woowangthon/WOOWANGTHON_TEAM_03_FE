{
  "name": "woowangthon-team-03-fe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:auth": "playwright test --config playwright.auth.config.js",
    "format": "prettier --write src tests *.js *.json index.html README.md",
    "format:check": "prettier --check src tests *.js *.json index.html README.md"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "vite": "8.3.6"
  }
}
